{
  "name": "assertis/simpledatabase-lib",
  "description": "An easy way to use PDO.",
  "authors": [
    {
      "name": "Michał Tatarynowicz",
      "email": "michal.tatarynowicz@assertis.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "Assertis\\SimpleDatabase\\": "src",
      "Tests\\Assertis\\SimpleDatabase\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.0.x-dev"
    }
  },
  "require": {
    "ext-pdo": "*",
    "php": "^8.4",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^12.1.2",
    "symfony/var-dumper": "^7.0"
  }
}
